{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {},
    "emitDeclarationOnly": true,
    "outDir": "./build",
    "rootDir": "./src",
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "**/*.spec.*",
    "**/*.test.*",
    "**/__fixtures__/**",
    "**/setup-vitest.ts",
    "**/test-utils.mjs",
    "**/oxlint-rule-tester.mjs",
    "**/oxlint-parity.mjs",
    "**/build-presets.mjs",
    "**/create-lint-tester.mjs"
  ]
}
