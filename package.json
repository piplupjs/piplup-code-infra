{
  "name": "@piplup/code-infra",
  "version": "1.2.0",
  "description": "Infra scripts and configs to be used across Piplup",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piplupjs/piplup-code-infra.git"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./eslint": {
      "types": "./build/eslint/index.d.mts",
      "default": "./src/eslint/index.mjs"
    },
    "./eslint/docs": {
      "types": "./build/eslint/docs.d.mts",
      "default": "./src/eslint/docs.mjs"
    },
    "./oxfmt": {
      "types": "./build/oxfmt.d.mts",
      "default": "./src/oxfmt.mjs"
    },
    "./oxlint": {
      "types": "./build/oxlint/index.d.mts",
      "default": "./src/oxlint/index.mjs"
    },
    "./prettier": {
      "types": "./build/prettier.d.mts",
      "default": "./src/prettier.mjs"
    },
    "./remark": {
      "types": "./build/remark/config.d.mts",
      "default": "./src/remark/config.mjs"
    },
    "./stylelint": {
      "types": "./build/stylelint/index.d.mts",
      "default": "./src/stylelint/index.mjs"
    }
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.build.json",
    "eslint": "eslint . --cache --report-unused-disable-directives --ext .js,.ts,.tsx --max-warnings 0",
    "eslint:ci": "eslint . --report-unused-disable-directives --ext .js,.ts,.tsx --max-warnings 0",
    "prettier": "pretty-quick --ignore-path .lintignore",
    "prettier:all": "prettier --write . --ignore-path .lintignore",
    "stylelint": "stylelint --report-invalid-scope-disables --report-needless-disables \"**/*.?(c|m)[jt]s?(x)\" \"**/*.css\" --ignore-path .lintignore",
    "typescript": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "oxlint:update-rules": "node scripts/update-oxlint-rules.mjs"
  },
  "files": [
    "build",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/__fixtures__/**",
    "!src/**/*.test.*",
    "!src/setup-vitest.ts",
    "!src/utils/test-utils.mjs",
    "!src/utils/oxlint-rule-tester.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Sadik Malik",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@typescript-eslint/types": "^8.72.2",
    "@typescript-eslint/utils": "^8.72.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-module-utils": "^2.14.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.9.5",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-package-json": "^1.14.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "globby": "^16.2.4",
    "minimatch": "^11.0.8",
    "postcss-styled-syntax": "^0.7.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-code-block-style": "^4.0.1",
    "remark-lint-fenced-code-flag": "^4.2.0",
    "remark-lint-heading-increment": "^4.0.1",
    "remark-lint-heading-style": "^4.0.1",
    "remark-lint-no-duplicate-headings": "^4.0.1",
    "remark-lint-no-empty-url": "^4.0.1",
    "remark-lint-no-heading-punctuation": "^4.0.1",
    "remark-lint-no-multiple-toplevel-headings": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-lint-no-unused-definitions": "^4.0.2",
    "remark-lint-table-pipes": "^5.0.1",
    "semver": "^7.8.6",
    "stylelint-config-standard": "^41.0.0",
    "typescript-eslint": "^8.72.2",
    "unified": "^11.0.5",
    "unified-lint-rule": "^3.0.1",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": "*",
    "eslint": "^9.0.0 || ^10.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.0.0",
    "stylelint": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/estree": "^1.0.8",
    "@types/estree-jsx": "^1.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript-eslint/rule-tester": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "enquirer": "^2.4.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.93.0",
    "prettier": "^3.10.1",
    "pretty-quick": "^4.2.2",
    "remark": "^15.0.1",
    "remark-mdx": "^3.1.1",
    "rimraf": "^6.1.2",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
